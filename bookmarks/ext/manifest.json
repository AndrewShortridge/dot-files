{
  "manifest_version": 3,
  "name": "bsession",
  "version": "0.2.0",
  "description": "Project browser sessions backed by ~/.config/bookmarks (native host: bsession)",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "alarms"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bsession@andrew.local",
      "strict_min_version": "139.0"
    }
  },
  "key": ""
}
